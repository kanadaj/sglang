# Reuse the published, accepted image byte-for-byte as the runtime base.
# Adds a source audit and standard module entrypoint; no serving profile.
# Inherited historical /opt/qwen-yarn files are unused; no OCI identity claim.
FROM kanadaj/sglang-qwen38fn-sm120-turbo:r22-tp2-vision-pad32-bias-20260907-v2@sha256:8cb9b598ba0be1bbd77924037a517d71e064ef72807b8b96b0fa5c78eeb2f3cc
COPY provenance /opt/qwen-package/provenance
COPY scripts/verify_source.py /opt/qwen-package/scripts/verify_source.py
RUN python3 /opt/qwen-package/scripts/verify_source.py --tree /sgl-workspace/sglang --complete
COPY LICENSE NOTICE /usr/share/doc/qwen-tp2-vision/
COPY licenses /usr/share/doc/qwen-tp2-vision/licenses/
ENTRYPOINT ["python3", "-m", "sglang.launch_server"]
CMD ["--help"]
