# Corrected runtime: immutable published vision ABI plus patch 0012 only.
# No serving profile or custom launcher. All serving args/env are external.
FROM kanadaj/sglang-qwen38fn-sm120-turbo:r22-tp2-vision-pad32-bias-20260907-v2@sha256:99fef9b4927e7e7c0dbd185a6bfe55995cea78e0d5a3c53e4409afb91109dc52
COPY provenance/runtime-files.vision-v2.json /opt/qwen-package/parent-runtime-files.json
RUN python3 -c 'import hashlib,json,pathlib; root=pathlib.Path("/sgl-workspace/sglang"); rows=json.load(open("/opt/qwen-package/parent-runtime-files.json")); mismatches=[p for p,r in rows.items() if hashlib.sha256((root/p).read_bytes()).hexdigest()!=r["sha256"]]; assert not mismatches,mismatches; print("Verified parent source files:",len(rows))'
COPY runtime/python/sglang/srt/model_loader/loader.py /sgl-workspace/sglang/python/sglang/srt/model_loader/loader.py
COPY runtime/python/sglang/srt/models/qwen4_exp.py /sgl-workspace/sglang/python/sglang/srt/models/qwen4_exp.py
COPY provenance/runtime-files.json /opt/qwen-package/provenance/runtime-files.json
COPY scripts/verify_source.py /opt/qwen-package/scripts/verify_source.py
RUN python3 /opt/qwen-package/scripts/verify_source.py --tree /sgl-workspace/sglang --complete
COPY LICENSE NOTICE /usr/share/doc/qwen-tp2-vision/
COPY licenses /usr/share/doc/qwen-tp2-vision/licenses/
ENTRYPOINT ["python3", "-m", "sglang.launch_server"]
CMD ["--help"]
