# Convenience-only derivative: unchanged published vision runtime.
FROM kanadaj/sglang-qwen38fn-sm120-turbo@sha256:99fef9b4927e7e7c0dbd185a6bfe55995cea78e0d5a3c53e4409afb91109dc52
COPY deploy /opt/qwen-yarn
COPY LICENSE NOTICE /usr/share/doc/qwen-tp2-vision/
COPY licenses /usr/share/doc/qwen-tp2-vision/licenses/
ENV HF_HOME=/cache/huggingface SGLANG_CACHE_DIR=/cache/sglang-generated \
    OMP_NUM_THREADS=1 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True SAFETENSORS_FAST_GPU=1
RUN python3 /opt/qwen-yarn/test_launcher.py && python3 /opt/qwen-yarn/test_standalone.py
ENTRYPOINT ["/opt/nvidia/nvidia_entrypoint.sh", "python3", "/opt/qwen-yarn/standalone.py"]
CMD []
