# Publish-only cumulative profile. Serving options remain external.
FROM docker.io/kanadaj/sglang-qwen38fn-sm120-turbo@sha256:f2859d1ccf824a5295088cf578eba89b0f3eeefff6ae7679c3f5d64af0689458
ARG SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/kanadaj/sglang" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      io.github.kanadaj.sglang.source-base-revision="a6d5284446b539f7ed95ddad9dfc2820f5778e2a" \
      org.opencontainers.image.description="PR15 HiCache diagnostics + PR16 Qwen strict tools; experimental HiCache, no deployment qualification"
COPY patches/0020-hicache-ple-state.patch patches/0021-hicache-file-integrity.patch patches/0022-hicache-qsa-sidecar.patch patches/0023-qsa-sparse-gather-memory-safety.patch patches/0024-router-pdl-bias-order.patch patches/0025-hicache-load-order.patch patches/0026-qsa-short-extend-bounds.patch patches/0027-qsa-paged-prefill.patch patches/0028-responses-stream-stability.patch patches/0029-hicache-common-boundary.patch patches/0030-hicache-selective-diagnostics.patch patches/0031-hicache-prefill-impact.patch patches/0032-qwen-default-strict-tools.patch patches/series.combined-release /opt/qwen-combined-release/patches/
COPY provenance/invalid-token-failure-runtime-files.json provenance/combined-release.json provenance/combined-release-runtime-files.json /opt/qwen-combined-release/provenance/
COPY scripts/verify_combined_release.py /opt/qwen-combined-release/scripts/verify_combined_release.py
RUN python3 -B /opt/qwen-combined-release/scripts/verify_combined_release.py --tree /sgl-workspace/sglang --apply \
    && python3 -c 'import pathlib, shutil; [shutil.rmtree(p) for p in pathlib.Path("/sgl-workspace/sglang/python/sglang").rglob("__pycache__")]'
ENTRYPOINT ["python3", "-m", "sglang.launch_server"]
CMD ["--help"]
