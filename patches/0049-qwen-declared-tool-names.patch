+        # Parse only original matches. Suppressed wrappers must never splice
+        # surrounding text into a newly executable call.
+        raw_tool_calls = []
+        normal_spans = []
+        cursor = 0
+        collecting_normal = True
+        for match in self.tool_call_regex.finditer(text):
+            if collecting_normal:
+                normal_spans.append(text[cursor : match.start()])
+            funcs = self.tool_call_function_regex.findall(match.group(1))
+            names = [(a or b).split(">", 1)[0] for a, b in funcs if ">" in (a or b)]
+            if not names or any(self._is_declared_tool(name, tools) for name in names):
+                raw_tool_calls.append(match.group(1))
+                collecting_normal = False
+            cursor = match.end()
+        if collecting_normal:
+            normal_spans.append(text[cursor:])
+        normal_text = "".join(normal_spans)
+        if cursor and not raw_tool_calls:
+            return StreamingParseResult(normal_text=normal_text)
+
