+def namespace_tool_names(tools: Any) -> Set[str]:
+    """Declared ``namespace`` prefixes; only these split on the way out."""
+    return {tool.name for tool in tools or [] if tool.type == "namespace" and tool.name}
+
+
+class NamespaceToolAliases:
+    """An exact, request-local bridge to flat names for Qwen function prompts."""
+
+    def __init__(self, tools: Any):
+        identities = set()
+        reserved = {
+            tool.name
+            for tool in tools or []
+            if tool.type in ("function", "custom") and tool.name
+        }
+        for tool in tools or []:
+            if tool.type != "namespace" or not tool.name:
+                continue
+            for member in tool.tools or []:
+                name = member.get("name") if isinstance(member, dict) else None
+                if not isinstance(name, str) or not name:
+                    raise ValueError(
+                        f"namespace tool {tool.name!r} has an inner tool without a name."
+                    )
+                identities.add((tool.name, name))
+        bases = {identity: f"{identity[0]}__{identity[1]}" for identity in identities}
+        counts = Counter(bases.values())
+        self.by_identity = {
+            identity: base
+            for identity, base in bases.items()
+            if counts[base] == 1
+            and base not in reserved
+            and re.fullmatch(r"[a-zA-Z0-9_-]{1,64}", base)
+        }
+        # Reserve natural spellings before allocating collision suffixes.
+        reserved.update(self.by_identity.values())
+        for identity in sorted(identities - self.by_identity.keys()):
+            readable = re.sub(r"[^a-zA-Z0-9_-]", "_", bases[identity])[:47]
+            attempt = 0
+            while True:
+                key = json.dumps([*identity, attempt], ensure_ascii=True).encode()
+                alias = readable + "_" + hashlib.sha256(key).hexdigest()[:16]
+                if alias not in reserved:
+                    break
+                attempt += 1
+            self.by_identity[identity] = alias
+            reserved.add(alias)
+        self.by_alias = {
+            alias: identity for identity, alias in self.by_identity.items()
+        }
+
+    def encode(self, namespace: str, name: str) -> str:
+        # Removed historical tools keep their original spelling in replay.
+        return self.by_identity.get((namespace, name), f"{namespace}.{name}")
+
+
+def namespace_members_to_chat_tools(
+    tool: Any, aliases: Optional[NamespaceToolAliases] = None
+) -> List[Any]:
+    """Flatten one ``namespace`` declaration into chat function tools named
+    ``{namespace}.{member}``, or the supplied exact alias.
+
+    Inner description and strict flags survive; the namespace description
+    fills members that omit one, the way OpenAI documents the grouping.
+    """
+    members = []
+    for inner in tool.tools or []:
+        inner_name = inner.get("name") if isinstance(inner, dict) else None
+        if not isinstance(inner_name, str) or not inner_name:
+            raise ValueError(
+                f"namespace tool {tool.name!r} has an inner tool without a name."
+            )
+        members.append(
+            Tool(
+                type="function",
+                function=Function(
+                    name=(
+                        aliases.encode(tool.name, inner_name)
+                        if aliases is not None
+                        else f"{tool.name}.{inner_name}"
+                    ),
+                    description=inner.get("description") or tool.description,
+                    parameters=inner.get("parameters"),
+                    strict=bool(inner.get("strict", False)),
+                ),
+            )
+        )
+    return members
+
+
+def split_namespaced_call(
+    name: str,
+    namespaces: Set[str],
+    declared_names: Set[str],
+    aliases: Optional[NamespaceToolAliases] = None,
+) -> Tuple[str, Optional[str]]:
+    """Map one model-facing call name onto its wire-item fields.
+
+    Returns ``(name, namespace)``. An exact declaration outranks a prefix
+    split, so a plain function whose name contains a dot is never
+    reinterpreted; undeclared dotted names pass through unchanged.
+    """
+    if name not in declared_names:
+        if aliases is not None and name in aliases.by_alias:
+            namespace, inner = aliases.by_alias[name]
+            return inner, namespace
+        namespace, _, inner = name.partition(".")
+        if namespace in namespaces and inner:
+            return inner, namespace
+    return name, None
+
+
+DEVELOPER_BLOCK_LABEL = "Developer instructions:"
+
+
+def label_developer_content(content: Any) -> Any:
+    """Prefix a ``developer`` message's text with its tier label.
+
+    Chat templates recognize system/user/assistant/tool, so a developer message
+    collapses to ``system``. Labelling the block keeps the tier legible instead
+    of flattening it into the surrounding instructions, where a model can read
+    it as one more conversational turn and let a later user message win.
+    """
+    if isinstance(content, str):
+        return f"{DEVELOPER_BLOCK_LABEL}\n{content}"
+    if isinstance(content, list):
+        for index, part in enumerate(content):
+            if isinstance(part, dict) and isinstance(part.get("text"), str):
+                labelled = dict(part)
+                labelled["text"] = f"{DEVELOPER_BLOCK_LABEL}\n{part['text']}"
+                return [*content[:index], labelled, *content[index + 1 :]]
+        return [{"type": "input_text", "text": DEVELOPER_BLOCK_LABEL}, *content]
+    return content
+
+
+_REASONING_STATE_PREFIX = "sglang-reasoning-v1."
+
+
+def encode_reasoning_state(text: str) -> str:
+    """Pack a reasoning trace into the blob ``reasoning.encrypted_content`` carries.
+
+    A ``store=false`` client replays reasoning items verbatim, so the trace has
+    to survive the round trip without server-side state. SGLang holds no key,
+    so this is an encoded -- not cryptographically protected -- payload: treat
+    it as opaque to clients, not as a confidentiality boundary.
+    """
+    packed = base64.urlsafe_b64encode(zlib.compress(text.encode("utf-8")))
+    return _REASONING_STATE_PREFIX + packed.decode("ascii")
+
+
+def decode_reasoning_state(blob: Any) -> Optional[str]:
+    if not isinstance(blob, str) or not blob.startswith(_REASONING_STATE_PREFIX):
+        return None
+    try:
+        raw = base64.urlsafe_b64decode(blob[len(_REASONING_STATE_PREFIX) :])
+        return zlib.decompress(raw).decode("utf-8")
+    except (ValueError, zlib.error, UnicodeDecodeError):
+        return None
